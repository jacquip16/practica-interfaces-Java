<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pilli.controlgastos.PrimaryController">
   <children>
      <Label text="Control de Gastos Semanales" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
      
      <HBox spacing="30.0" alignment="CENTER">
         <children>
            <!-- Columna izquierda: Entradas de gastos -->
            <VBox spacing="10.0">
               <children>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Label text="Alimentación" />
                        <TextField fx:id="txtAlimentacion" prefWidth="90.0" alignment="CENTER_RIGHT" promptText="800" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Label text="Refrigerios" />
                        <TextField fx:id="txtRefrigerios" prefWidth="90.0" alignment="CENTER_RIGHT" promptText="300" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Label text="Transporte" />
                        <TextField fx:id="txtTransporte" prefWidth="90.0" alignment="CENTER_RIGHT" promptText="600" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Label text="Telefonía" />
                        <TextField fx:id="txtTelefonia" prefWidth="90.0" alignment="CENTER_RIGHT" promptText="50" />
                     </children>
                  </HBox>
                  <HBox spacing="10.0" alignment="CENTER_RIGHT">
                     <children>
                        <Label text="Otros" />
                        <TextField fx:id="txtOtros" prefWidth="90.0" alignment="CENTER_RIGHT" promptText="33" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Columna derecha: Resultados / Estadísticas -->
            <VBox spacing="10.0" alignment="TOP_CENTER">
               <children>
                  <Label text="Estadísticas" style="-fx-font-weight: bold;" />
                  
                  <Label text="Total semanal" />
                  <TextField fx:id="txtTotal" editable="false" prefWidth="120.0" alignment="CENTER" />
                  
                  <Label text="Gasto más alto" />
                  <TextField fx:id="txtGastoMasAlto" editable="false" prefWidth="120.0" alignment="CENTER" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Botones de acción -->
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="btnCalcular" text="Calcular estadísticas" onAction="#btnCalcular_click" />
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar_click" prefWidth="90.0" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>