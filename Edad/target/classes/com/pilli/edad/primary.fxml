<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" 
      xmlns="http://javafx.com/javafx/8.0.171" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.pilli.edad.PrimaryController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Fecha de nacimiento (Año):" />
            <TextField fx:id="txtAnio" promptText="aaaa" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="btnCalcular" text="Calcular" onAction="#btnCalcular_click"/>
            <Button fx:id="btnLimpiar" text="Limpiar" onAction="#btnLimpiar_click"/>
         </children>
      </HBox>
      
      <Label fx:id="lblResultado" text="" style="-fx-font-size: 14px; -fx-font-style: italic;" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>